# Copy to .env. Do not commit .env or paste secrets in tickets/chat.
# Generate each secret locally, for example:
#   openssl rand -hex 48

# Pin this to a tested release before a production rollout. The default tracks CE latest locally.
CHATWOOT_IMAGE=chatwoot/chatwoot:latest-ce
CHATWOOT_HOST_PORT=3001

# Local URL only. Production must use the final HTTPS URL behind a reverse proxy.
FRONTEND_URL=http://localhost:3001
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
SECRET_KEY_BASE=REPLACE_WITH_A_LOCAL_ALPHANUMERIC_SECRET

# Dedicated Chatwoot data stores. Never point these at Mujeeb's commercial PostgreSQL database.
POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_A_LOCAL_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_A_LOCAL_REDIS_PASSWORD@redis:6379

# Local storage is intentionally sufficient for development only.
ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=5
ENABLE_ACCOUNT_SIGNUP=false
FORCE_SSL=false
DEFAULT_LOCALE=ar
MAILER_SENDER_EMAIL=Mujeeb Support <support@example.test>

# Deliberately blank: no social channel, OAuth, SMTP, object storage, or AI credentials belong here.
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
IG_VERIFY_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
