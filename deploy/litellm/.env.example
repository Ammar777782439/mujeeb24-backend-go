# Copy to deploy/litellm/.env, fill strong independently random secrets.
# NEVER commit deploy/litellm/.env, credentials, master key or a real provider API key.
# Production: pin an audited immutable LiteLLM Docker image tag/digest.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_POSTGRES_PASSWORD=
