# هذا الـgateway يمنع كشف أي endpoint غير SocialAPI Webhook.
:8080 {
	@socialapi_webhooks path /api/v1/webhooks/socialapi/*
	handle @socialapi_webhooks {
		reverse_proxy mujeeb-api:3001
	}

	@socialapi_oauth_callback path /oauth/socialapi/callback
	handle @socialapi_oauth_callback {
		reverse_proxy mujeeb-api:3001
	}

	@chatwoot_webhooks path /api/v1/webhooks/chatwoot/*
	handle @chatwoot_webhooks {
		reverse_proxy mujeeb-api:3001
	}

	respond "not found" 404
}
