# لا ترفع deploy/local/.env إلى Git.

MUJEEB_POSTGRES_DATABASE=mujeeb24
MUJEEB_POSTGRES_USERNAME=mujeeb
MUJEEB_POSTGRES_PASSWORD=replace-with-generated-local-value
MUJEEB_HOST_PORT=3001

# اترك الميزات الخارجية مغلقة إلى أن تهيئها عمدًا.
SOCIALAPI_BASE_URL=https://api.social-api.ai
SOCIALAPI_API_KEY=
SOCIALAPI_WEBHOOK_SECRET=
CHANNEL_PROVISIONING_ENABLED=false
# يلزم HTTPS عند تفعيل provisioning؛ يعيد SocialAPI المستخدم إلى هذا العنوان بعد OAuth.
CHANNEL_PROVISIONING_REDIRECT_URI=

# الرد الآلي يستقبل SocialAPI inbound الموثق ويستخدم LLM من خلال policy gate وOutbox.
AUTOREPLY_ENABLED=false

# Named Tunnel فقط. اتركه فارغًا مع Quick Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# LiteLLM Gateway (set true only after configuring deploy/litellm/compose.yaml).
# When API is in Docker, 127.0.0.1 points to this API container; use a
# reachable private gateway address, not the Windows host loopback address.
LITELLM_GATEWAY_ONLY=false
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Approved accounting rate used for USD spend to YER subscription budgets.
LITELLM_USD_TO_YER_RATE=
LITELLM_CUSTOMER_MODEL=mujeeb-customer
LITELLM_CATALOG_MODEL=mujeeb-catalog
LITELLM_MERCHANT_MODEL=mujeeb-merchant
LITELLM_HTTP_TIMEOUT=20s
LITELLM_MAX_OUTPUT_TOKENS=4096
LITELLM_MAX_INPUT_CHARACTERS=48000
LITELLM_MAX_CONTEXT_TOKENS=32768
LITELLM_MERCHANT_MAX_REQUEST_BYTES=524288
