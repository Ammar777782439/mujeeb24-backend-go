# أنشئ .env عبر: powershell -ExecutionPolicy Bypass -File scripts/init-test-env.ps1
# لا ترفع deploy/local/.env إلى Git.

MUJEEB_POSTGRES_DATABASE=mujeeb24
MUJEEB_POSTGRES_USERNAME=mujeeb
MUJEEB_POSTGRES_PASSWORD=replace-with-generated-local-value
MUJEEB_HOST_PORT=3001

POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=replace-with-generated-local-value
REDIS_PASSWORD=replace-with-generated-local-value
SECRET_KEY_BASE=replace-with-generated-local-value
FRONTEND_URL=http://localhost:3002
CHATWOOT_HOST_PORT=3002
ACTIVE_STORAGE_SERVICE=local
ENABLE_ACCOUNT_SIGNUP=true

# اترك الميزات الخارجية مغلقة إلى أن تهيئها عمدًا.
SOCIALAPI_BASE_URL=https://api.social-api.ai
SOCIALAPI_API_KEY=
SOCIALAPI_WEBHOOK_SECRET=
CHATWOOT_BASE_URL=http://chatwoot-rails:3000
CHATWOOT_API_TOKEN=
CHATWOOT_PLATFORM_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_MIRROR_ENABLED=false
CHATWOOT_AUTOREPLY_ENABLED=false
CHATWOOT_PROVISIONING_ENABLED=false
# ضع base URL فقط؛ Mujeeb يضيف تلقائيًا route key خاصًا بكل قناة.
CHANNEL_PROVISIONING_REDIRECT_URI=
CHANNEL_PROVISIONING_WEBHOOK_URL=
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Named Tunnel فقط. اتركه فارغًا مع Quick Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
