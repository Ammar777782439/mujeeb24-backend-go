# لا ترفع deploy/local/.env إلى Git.

MUJEEB_POSTGRES_DATABASE=mujeeb24
MUJEEB_POSTGRES_USERNAME=mujeeb
MUJEEB_POSTGRES_PASSWORD=replace-with-generated-local-value
MUJEEB_HOST_PORT=3001

# اترك الميزات الخارجية مغلقة إلى أن تهيئها عمدًا.
SOCIALAPI_BASE_URL=https://api.social-api.ai
SOCIALAPI_API_KEY=
SOCIALAPI_WEBHOOK_SECRET=
CHANNEL_PROVISIONING_ENABLED=false
# يلزم HTTPS عند تفعيل provisioning؛ يعيد SocialAPI المستخدم إلى هذا العنوان بعد OAuth.
CHANNEL_PROVISIONING_REDIRECT_URI=

# الرد الآلي يستقبل SocialAPI inbound الموثق ويستخدم LLM من خلال policy gate وOutbox.
AUTOREPLY_ENABLED=false

# Named Tunnel فقط. اتركه فارغًا مع Quick Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# Native provider integration for local API.
NATIVE_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
NATIVE_AI_HTTP_TIMEOUT=20s
NATIVE_AI_MAX_CONTEXT_TOKENS=32768
NATIVE_AI_MAX_OUTPUT_TOKENS=4096
NATIVE_AI_MAX_INPUT_CHARACTERS=48000
NATIVE_AI_MERCHANT_MAX_REQUEST_BYTES=524288

# Opt-in catalog evaluation dump (local development only).
MUJEEB_CATALOG_DEBUG_DUMP=false
MUJEEB_CATALOG_DEBUG_FILE=tmp/catalog-debug/catalog-evaluation.jsonl
