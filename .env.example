HTTP_ADDR=:3001
SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://user:password@localhost:5432/mujeeb24?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

# Provider credentials are injected server-side and never committed.
SOCIALAPI_BASE_URL=https://api.social-api.ai
SOCIALAPI_API_KEY=
SOCIALAPI_WEBHOOK_SECRET=
SOCIALAPI_HTTP_TIMEOUT=10s

# Merchant Channel Provisioning through SocialAPI OAuth. Disabled by default.
CHANNEL_PROVISIONING_ENABLED=false
CHANNEL_PROVISIONING_REDIRECT_URI=https://app.example.invalid/oauth/socialapi/callback
FRONTEND_URL=http://localhost:5173

# AutoReply uses LiteLLM Gateway only. Direct LLM_ENABLED/LLM_BASE_URL settings are retired.
AUTOREPLY_ENABLED=false

# Existing independent operational settings (unrelated to retired LLM runtime).
AI_PROVIDER_API_KEY=
INTERNAL_API_KEY=
LOG_LEVEL=info

# LiteLLM Gateway (the only active Mujeeb AI runtime)
# ============================================================================
# First start LiteLLM separately: deploy/litellm/README-ar.md
# Gateway-only mode uses LiteLLM for B2C + summary + full catalog + B2B.
# Keep false until routes and keys have been configured and smoke-tested.
LITELLM_GATEWAY_ONLY=false
# Run Go backend on Windows host: http://127.0.0.1:4000
# If API runs in Docker, use a reachable private gateway hostname instead.
LITELLM_BASE_URL=http://127.0.0.1:4000
# A LiteLLM *virtual key* created in its Admin UI; NOT Google/Groq model API key.
# Required for native LiteLLM USD spend to match Mujeeb YER budgets.
# Set the explicit accounting exchange rate; never assume one silently.
LITELLM_USD_TO_YER_RATE=
LITELLM_API_KEY=
# The aliases must exist in LiteLLM UI (or its config) and support Mujeeb tools.
LITELLM_CUSTOMER_MODEL=mujeeb-customer
LITELLM_CATALOG_MODEL=mujeeb-catalog
LITELLM_MERCHANT_MODEL=mujeeb-merchant
LITELLM_HTTP_TIMEOUT=20s
LITELLM_MAX_OUTPUT_TOKENS=4096
LITELLM_MAX_INPUT_CHARACTERS=48000
LITELLM_MAX_CONTEXT_TOKENS=32768
LITELLM_MERCHANT_MAX_REQUEST_BYTES=524288

# Enabling real customer messaging still requires your existing SocialAPI
# credentials, business policy configuration, and both flags when appropriate:
# AUTOREPLY_ENABLED=true
# CUSTOMER_SALES_ENABLED=true
# Do not set legacy LLM_ENABLED / LLM_BASE_URL / LLM_API_KEY values.
