APP_ENV=development
HTTP_ADDR=:3001
SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://user:password@localhost:5432/mujeeb24?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

# Reserved for a later reliability/provider phase; PR-014 does not connect Redis.
REDIS_URL=redis://localhost:6379/1

# Provider credentials are injected server-side and never committed.
SOCIALAPI_BASE_URL=https://api.social-api.ai
SOCIALAPI_API_KEY=
SOCIALAPI_WEBHOOK_SECRET=
SOCIALAPI_HTTP_TIMEOUT=10s

# Chatwoot credentials are injected server-side and never committed.
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_HTTP_TIMEOUT=10s

# Optional OpenAI-compatible LLM runtime. Disabled by default; never commit the real key.
LLM_ENABLED=false
LLM_BASE_URL=https://api.example.invalid/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_HTTP_TIMEOUT=30s
LLM_MAX_OUTPUT_TOKENS=700
LLM_MAX_INPUT_CHARACTERS=12000
LLM_OUTPUT_TOKENS_FIELD=max_completion_tokens

AI_PROVIDER_API_KEY=
INTERNAL_API_KEY=
LOG_LEVEL=info

# Merchant Channel Provisioning. Disabled by default.
# Chatwoot Platform API provisioning is supported only for self-hosted Chatwoot.
CHANNEL_PROVISIONING_ENABLED=false
CHATWOOT_PLATFORM_API_TOKEN=
CHANNEL_PROVISIONING_REDIRECT_URI=https://app.example.invalid/oauth/socialapi/callback
CHANNEL_PROVISIONING_WEBHOOK_URL=https://app.example.invalid/webhooks/chatwoot

# When enabled, SOCIALAPI_API_KEY and the self-hosted Chatwoot platform token are required.
# Never commit real values.
