HTTP_ADDR=:3001
SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://user:password@localhost:5432/mujeeb24?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

# Provider credentials are injected server-side and never committed.
# Independent private-media switches. Conversation storage is initialized only
# for the worker; media download/verification remains gated until its worker slice is enabled.
CATALOG_MEDIA_ENABLED=false
CONVERSATION_MEDIA_ENABLED=false
S3_PROVIDER=r2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SOCIALAPI_BASE_URL=https://api.social-api.ai
SOCIALAPI_API_KEY=
SOCIALAPI_WEBHOOK_SECRET=
SOCIALAPI_HTTP_TIMEOUT=10s

# Merchant Channel Provisioning through SocialAPI OAuth. Disabled by default.
CHANNEL_PROVISIONING_ENABLED=false
CHANNEL_PROVISIONING_REDIRECT_URI=https://app.example.invalid/oauth/socialapi/callback
FRONTEND_URL=http://localhost:5173

# DeepSeek is the configured native inference provider. No Gemini key or fallback required.
# Keys are deployment secrets. Never commit real values.
AUTOREPLY_ENABLED=false
CUSTOMER_SALES_ENABLED=false
NATIVE_AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
NATIVE_AI_HTTP_TIMEOUT=20s
NATIVE_AI_MAX_CONTEXT_TOKENS=32768
NATIVE_AI_MAX_OUTPUT_TOKENS=4096
NATIVE_AI_MAX_INPUT_CHARACTERS=48000
NATIVE_AI_MERCHANT_MAX_REQUEST_BYTES=524288

# Independent service configuration
LOG_LEVEL=info
# Enable customer replies after setting the DeepSeek and SocialAPI keys,
# checking production model qualification and confirming accounting controls.
