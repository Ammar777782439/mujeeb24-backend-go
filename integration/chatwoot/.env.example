# Chatwoot integration-only environment. Copy to .env locally; never commit .env.
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
FRONTEND_URL=http://localhost:3300
SECRET_KEY_BASE=replace-with-local-random-value
ENABLE_ACCOUNT_SIGNUP=true
ACTIVE_STORAGE_SERVICE=local

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace-with-local-random-value

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace-with-local-random-value

# Optional external API values are intentionally absent from this local template.
